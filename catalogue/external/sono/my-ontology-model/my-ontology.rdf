<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF
    xml:base="http://example.org/ontology/my-ontology/"
    xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
    xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
    xmlns:owl="http://www.w3.org/2002/07/owl#"
    xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
    xmlns:ont="http://example.org/ontology/my-ontology/">

    <owl:Ontology rdf:about="http://example.org/ontology/my-ontology/">
        <rdfs:label>My Ontology</rdfs:label>
    </owl:Ontology>

    <!-- ===================== -->
    <!-- Entity Types (Classes) -->
    <!-- ===================== -->

    <owl:Class rdf:about="http://example.org/ontology/my-ontology/New-entity-4">
        <rdfs:label>客户</rdfs:label>
        <ont:icon>📋</ont:icon>
        <ont:color>#5C2D91</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/my-ontology/New-entity-3">
        <rdfs:label>供应商</rdfs:label>
        <ont:icon>🏢</ont:icon>
        <ont:color>#D83B01</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/my-ontology/New-entity-2">
        <rdfs:label>采购</rdfs:label>
        <ont:icon>👤</ont:icon>
        <ont:color>#107C10</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/my-ontology/New-entity-1">
        <rdfs:label>合同</rdfs:label>
        <ont:icon>📦</ont:icon>
        <ont:color>#0078D4</ont:color>
    </owl:Class>

    <!-- ================ -->
    <!-- Data Properties -->
    <!-- ================ -->

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/my-ontology/new-entity-4_id">
        <rdfs:label>id</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/my-ontology/New-entity-4"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <ont:isIdentifier rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ont:isIdentifier>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/my-ontology/new-entity-3_id">
        <rdfs:label>id</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/my-ontology/New-entity-3"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <ont:isIdentifier rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ont:isIdentifier>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/my-ontology/new-entity-2_id">
        <rdfs:label>id</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/my-ontology/New-entity-2"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <ont:isIdentifier rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ont:isIdentifier>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/my-ontology/new-entity-1_id">
        <rdfs:label>id</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/my-ontology/New-entity-1"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <ont:isIdentifier rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ont:isIdentifier>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <!-- ================== -->
    <!-- Object Properties -->
    <!-- ================== -->

    <owl:ObjectProperty rdf:about="http://example.org/ontology/my-ontology/rel-relates-to-4">
        <rdfs:label>relates_to</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/my-ontology/New-entity-2"/>
        <rdfs:range rdf:resource="http://example.org/ontology/my-ontology/New-entity-1"/>
        <ont:cardinality>one-to-many</ont:cardinality>
        <ont:fromEntityId>new-entity-2</ont:fromEntityId>
        <ont:toEntityId>new-entity-1</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/my-ontology/rel-relates-to-3">
        <rdfs:label>relates_to</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/my-ontology/New-entity-4"/>
        <rdfs:range rdf:resource="http://example.org/ontology/my-ontology/New-entity-1"/>
        <ont:cardinality>one-to-many</ont:cardinality>
        <ont:fromEntityId>new-entity-4</ont:fromEntityId>
        <ont:toEntityId>new-entity-1</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/my-ontology/rel-relates-to-2">
        <rdfs:label>relates_to</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/my-ontology/New-entity-2"/>
        <rdfs:range rdf:resource="http://example.org/ontology/my-ontology/New-entity-4"/>
        <ont:cardinality>one-to-many</ont:cardinality>
        <ont:fromEntityId>new-entity-2</ont:fromEntityId>
        <ont:toEntityId>new-entity-4</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/my-ontology/rel-relates-to-1">
        <rdfs:label>relates_to</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/my-ontology/New-entity-2"/>
        <rdfs:range rdf:resource="http://example.org/ontology/my-ontology/New-entity-3"/>
        <ont:cardinality>one-to-many</ont:cardinality>
        <ont:fromEntityId>new-entity-2</ont:fromEntityId>
        <ont:toEntityId>new-entity-3</ont:toEntityId>
    </owl:ObjectProperty>

</rdf:RDF>
